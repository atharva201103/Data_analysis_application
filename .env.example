# LLM Configuration
# Options: ollama, openai, groq, gemini, anthropic
LLM_PROVIDER=gemini
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=gemini-2.5-flash-lite
LLM_API_KEY=

# Optional cloud API keys
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Application Settings
MAX_UPLOAD_SIZE_MB=50
ENABLE_AI_FEATURES=true
DEFAULT_THEME=dark
